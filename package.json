{
  "name": "@ctrlpi/mcp-bridge",
  "version": "0.9.30",
  "description": "An MCP (Model Context Protocol) server that lets an AI agent (e.g. Claude Desktop) control one or more GPIO agents (pi-gpio-api on a Raspberry Pi, pico-gpio-api on a Pico W or Pico 2 W, esp32-gpio-api on an ESP32) by calling their REST API over HTTP.",
  "main": "server.js",
  "files": [
    "server.js",
    "test",
    "mock_agent.py"
  ],
  "bin": {
    "mcp-bridge": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "run": "node server.js",
    "test": "node --test test/mcp-bridge.test.js",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrlpi/mcp-bridge.git"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "gpio",
    "raspberry pi",
    "raspberry-pi-pico",
    "raspberry pico",
    "pico",
    "esp32",
    "claude",
    "ai",
    "llm",
    "ctrlpi",
    "esp32-c3",
    "esp32-s3",
    "raspberry-pi",
    "raspberry",
    "pi",
    "pico-pi",
    "model-context-protocol",
    "iot"
  ],
  "author": "ctrlPi",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/ctrlpi/mcp-bridge/issues"
  },
  "homepage": "https://ctrlpi.com"
}
